# Offline dependency sources supplied explicitly by the local build driver.
if(NOT IRON_DEPS_DIR)
  message(FATAL_ERROR "Set IRON_DEPS_DIR to the prepared dependency sources")
endif()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
if(ANDROID)
  # SDLActivity always calls HIDDeviceManager's JNI callbacks during onCreate.
  # Disabling HIDAPI removes those exports and crashes before SDL_main runs.
  set(SDL_HIDAPI ON CACHE BOOL "" FORCE)
else()
  set(SDL_HIDAPI OFF CACHE BOOL "" FORCE)
endif()
add_subdirectory("${IRON_DEPS_DIR}/sdl2" "${CMAKE_BINARY_DIR}/deps/sdl2" EXCLUDE_FROM_ALL)
add_library(PkgConfig::SDL ALIAS SDL2)
set(OPUS_BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(OPUS_BUILD_PROGRAMS OFF CACHE BOOL "" FORCE)
set(OPUS_INSTALL_PKG_CONFIG_MODULE OFF CACHE BOOL "" FORCE)
add_subdirectory("${IRON_DEPS_DIR}/opus" "${CMAKE_BINARY_DIR}/deps/opus" EXCLUDE_FROM_ALL)
set(OPUS_INCLUDE_DIR "${IRON_DEPS_DIR}/opus/include")
set(OPUS_LIBRARY opus)
if(ANDROID)
  if(NOT EXISTS "${IRON_OPENXR_ANDROID}/jni/arm64-v8a/libopenxr_loader.so")
    message(FATAL_ERROR "Set IRON_OPENXR_ANDROID to the official Khronos loader AAR")
  endif()
  add_library(iron-openxr SHARED IMPORTED GLOBAL)
  set_target_properties(iron-openxr PROPERTIES
    IMPORTED_LOCATION "${IRON_OPENXR_ANDROID}/jni/arm64-v8a/libopenxr_loader.so"
    INTERFACE_INCLUDE_DIRECTORIES "${IRON_OPENXR_ANDROID}/prefab/modules/headers/include")
else()
  set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(BUILD_API_LAYERS OFF CACHE BOOL "" FORCE)
  set(BUILD_CONFORMANCE_TESTS OFF CACHE BOOL "" FORCE)
  set(BUILD_LOADER ON CACHE BOOL "" FORCE)
  set(DYNAMIC_LOADER ON CACHE BOOL "" FORCE)
  add_subdirectory("${IRON_DEPS_DIR}/openxr" "${CMAKE_BINARY_DIR}/deps/openxr" EXCLUDE_FROM_ALL)
  # The loader's Clang branch assumes an ELF linker even for MinGW targets.
  # PE exports use its supplied module definition instead of a version script.
  set_target_properties(openxr_loader PROPERTIES LINK_FLAGS "")
  target_sources(openxr_loader PRIVATE "${IRON_DEPS_DIR}/openxr/src/loader/openxr-loader.def")
  add_library(iron-glew STATIC "${IRON_DEPS_DIR}/glew/src/glew.c")
  target_include_directories(iron-glew PUBLIC "${IRON_DEPS_DIR}/glew/include")
  target_compile_definitions(iron-glew PUBLIC GLEW_STATIC)
  target_link_libraries(iron-glew PUBLIC opengl32)
endif()
if(ANDROID)
  add_library(PkgConfig::OPENXR ALIAS iron-openxr)
else()
  add_library(PkgConfig::OPENXR ALIAS openxr_loader)
endif()
